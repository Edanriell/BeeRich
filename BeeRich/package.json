{
	"name": "beerich",
	"private": true,
	"sideEffects": false,
	"type": "module",
	"scripts": {
		"routes": "remix routes",
		"typecheck": "tsc",
		"lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
		"format": "run-s format:*",
		"format:lint": "eslint --fix --ext .js,.jsx,.ts,.tsx .",
		"format:db": "npx prisma format",
		"clean": "rimraf ./node_modules .cache ./build ./public/build && npm i",
		"build": "run-s \"build:*\"",
		"build:remix": "remix vite:build",
		"build:db": "npx prisma generate",
		"update:db": "npx prisma db push",
		"update:remix": "npm i @remix-run/express@2 @remix-run/node@2 @remix-run/react@2 @remix-run/dev@2 @remix-run/eslint-config@2 @remix-run/css-bundle@2",
		"seed": "npx tsx prisma/seed.ts",
		"reset:db": "rimraf ./prisma/dev.db && npm run update:db && npm run seed",
		"dev": "run-p \"dev:*\"",
		"dev:remix": "remix vite:dev",
		"start": "cross-env NODE_ENV=production remix-serve ./build/server/index.js"
	},
	"dependencies": {
		"@prisma/client": "^6.4.1",
		"@remix-run/css-bundle": "^2.16.0",
		"@remix-run/express": "^2.16.0",
		"@remix-run/node": "^2.16.0",
		"@remix-run/react": "^2.16.0",
		"@remix-run/serve": "^2.16.0",
		"bcryptjs": "^3.0.2",
		"clsx": "^2.1.1",
		"compression": "^1.8.0",
		"cross-env": "^7.0.3",
		"express": "^4.21.2",
		"isbot": "^4.1.0",
		"morgan": "^1.10.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0",
		"source-map-support": "^0.5.21",
		"zod": "^3.24.2"
	},
	"devDependencies": {
		"@remix-run/dev": "^2.16.0",
		"@remix-run/eslint-config": "^2.16.0",
		"@types/bcryptjs": "^2.4.6",
		"@types/compression": "^1.7.5",
		"@types/express": "^5.0.0",
		"@types/morgan": "^1.9.9",
		"@types/node": "^22.13.9",
		"@types/react": "^18.2.20",
		"@types/react-dom": "^18.2.7",
		"@types/source-map-support": "^0.5.10",
		"@typescript-eslint/eslint-plugin": "^6.7.4",
		"@typescript-eslint/parser": "^6.7.4",
		"autoprefixer": "^10.4.19",
		"chokidar": "^4.0.3",
		"eslint": "^8.38.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-import-resolver-typescript": "^3.6.1",
		"eslint-plugin-html": "^8.1.2",
		"eslint-plugin-import": "^2.28.1",
		"eslint-plugin-jsx-a11y": "^6.7.1",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-react": "^7.33.2",
		"eslint-plugin-react-hooks": "^4.6.0",
		"eslint-plugin-simple-import-sort": "^12.1.1",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.4.38",
		"prettier": "^3.5.3",
		"prisma": "^6.4.1",
		"rimraf": "^6.0.1",
		"tailwindcss": "^3.4.4",
		"tsx": "^4.19.3",
		"typescript": "^5.1.6",
		"vite": "^6.0.0",
		"vite-tsconfig-paths": "^4.2.1"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
